        "\n",
        "# Phase 4: Regional Expansion — Boston CPI\n",
        "# FRED Code: CUURA103SA0 = Consumer Price Index for All Urban Consumers: All Items in Boston-Cambridge-Newton, MA-NH\n",
        "\n",
        "# Fetch Boston CPI\n",
        "boston_cpi = fred.get_series('CUURA103SA0')\n",
        "\n",
        "# Convert to DataFrame and filter to 2016 onwards\n",
        "boston_df = pd.DataFrame({'Boston_CPI': boston_cpi})\n",
        "boston_df = boston_df.loc['2016-01-01':]\n",
        "\n",
        "# Handle missing values (Boston data is bimonthly, so there are gaps)\n",
        "# Forward fill: fills missing values with the previous valid value\n",
        "boston_df = boston_df.ffill()\n",
        "\n",
        "# Normalize Boston CPI to Jan 2016 = 100\n",
        "Value_at_Start_Date_Boston = boston_df['Boston_CPI'].iloc[0]\n",
        "boston_df['Boston_CPI_Normalized'] = (boston_df['Boston_CPI'] / Value_at_Start_Date_Boston) * 100\n",
        "\n",
        "# Merge Boston data with our main DataFrame\n",
        "df_combined = df_normalized.copy()\n",
        "df_combined['Boston_CPI'] = boston_df['Boston_CPI_Normalized']\n",
        "\n",
        "# Forward fill again in case of any remaining gaps after merge\n",
        "df_combined = df_combined.ffill()\n",
        "\n",
        "# Plot: National CPI (Grey), Boston CPI (Blue), Student SPI (Red)\n",
        "plt.figure(figsize=(12, 6))\n",
        "\n",
        "plt.plot(df_combined.index, df_combined['CPI'], label='National CPI', linewidth=2, color='grey')\n",
        "plt.plot(df_combined.index, df_combined['Boston_CPI'], label='Boston CPI', linewidth=2, color='blue')\n",
        "plt.plot(df_combined.index, df_combined['Student_SPI'], label='Student SPI', linewidth=2, color='red')\n",
        "\n",
        "plt.title('National CPI vs Boston CPI vs Student SPI (2016 = 100)')\n",
        "plt.xlabel('Year')\n",
        "plt.ylabel('Index Value')\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
